# Documentation only. The deployment notebook writes env/.env from actual outputs.
# Do not copy this file to .env or enter credentials here.
AZURE_SUBSCRIPTION_ID=<deployment-subscription-id>
AZURE_TENANT_ID=<setup-user-tenant-id>
AZURE_RESOURCE_GROUP=<demo-owned-group-name>
AZURE_RESOURCE_GROUP_ID=/subscriptions/<subscription-id>/resourceGroups/<demo-owned-group-name>
AZURE_LOCATION=northeurope
AZURE_SEARCH_SERVICE_NAME=<deployed-search-name>
AZURE_SEARCH_RESOURCE_ID=/subscriptions/<subscription-id>/resourceGroups/<group-name>/providers/Microsoft.Search/searchServices/<search-name>
# searchEndpoint | HTTPS endpoint, no credentials/query string
AZURE_SEARCH_ENDPOINT=https://<deployed-search-name>.search.windows.net
# operatorObjectId | Signed-in setup user's object ID
AZURE_OPERATOR_OBJECT_ID=<setup-user-object-id>
