# Contract only. 01_deploy_infra.ipynb generates env/.env after successful deployment.
# Never commit env/.env. No API keys are retrieved.
# 02_configure.ipynb generates non-secret gateway.json and direct-call .env settings.
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_LOCATION=
AZURE_ACCOUNT_NAME=
AZURE_AI_RESOURCE_ID=
AZURE_AI_ENDPOINT=
AZURE_AI_PROJECT_NAME=
AZURE_AI_PROJECT_ID=
# Consuming project endpoint without /openai/v1/; also used by the AI Projects SDK example.
AZURE_AI_PROJECT_ENDPOINT=
AZURE_APIM_NAME=
AZURE_APIM_RESOURCE_ID=
APIM_ENDPOINT=
AZURE_SEARCH_NAME=
AZURE_SEARCH_RESOURCE_ID=
AZURE_SEARCH_ENDPOINT=
AZURE_BACKEND_RESOURCE_GROUP=
AZURE_BACKEND_LOCATION=
AZURE_BACKEND_ACCOUNT_NAME=
AZURE_BACKEND_RESOURCE_ID=
AZURE_BACKEND_ENDPOINT=
AZURE_BACKEND_OPENAI_ENDPOINT=
AZURE_BACKEND_DEPLOYMENT_NAME=
AZURE_BACKEND_MODEL_VERSION=
AZURE_BACKEND_MODEL_SKU=
AZURE_BACKEND_MODEL_CAPACITY=

# Optional explicit Entra user caller for this repo's gateway Bicep.
# Set the user object ID in the deployment tenant, then rerun 02_configure.
# Empty keeps project-only access. This is not a credential.
APIM_ALLOWED_USER_OBJECT_ID=

# 04_direct_api reads these values only from env/.env, not gateway.json.
# 02_configure generates URL/model/scope for this repo's deployment.
# External gateway users may supply equivalent settings directly instead.
# BASE_URL is the complete HTTPS OpenAI v1 base URL, ending in /openai/v1/.
APIM_BASE_URL=
APIM_MODEL_NAME=
# No key: use DefaultAzureCredential and this endpoint's token scope.
# This repo's gateway scope is https://cognitiveservices.azure.com/.default.
APIM_TOKEN_SCOPE=
# Key present: use this key, with no automatic Entra retry.
# This repo's gateway remains Entra-only; keys are for existing external gateways.
APIM_API_KEY=
# Omit for standard Authorization: Bearer <key>; otherwise the exact key header,
# for example Ocp-Apim-Subscription-Key or api-key. No backend keys are retrieved.
APIM_API_KEY_HEADER=

# Foundry Responses settings; validate each endpoint/model/authentication combination.
# 02_configure generates the consuming project OpenAI v1 base URL/model/scope.
# External users may supply a consuming resource or project base URL, not the backend:
# https://<resource>.services.ai.azure.com/openai/v1/
# https://<resource>.services.ai.azure.com/api/projects/<project>/openai/v1/
# Rerunning Write Gateway Settings replaces these URL/model/scope fields, not keys.
FOUNDRY_BASE_URL=
# Exact model reference to test, for example byom01-gateway/gpt-5.4; passed unchanged.
FOUNDRY_MODEL_NAME=
# No key: use DefaultAzureCredential with the endpoint's scope.
# Documented Foundry v1 scope: https://ai.azure.com/.default (not the APIM scope).
FOUNDRY_TOKEN_SCOPE=
# Leave empty for Entra-only deployments. A nonempty key takes precedence.
FOUNDRY_API_KEY=
# Omit for standard Authorization: Bearer <key>; set api-key if required.
FOUNDRY_API_KEY_HEADER=
