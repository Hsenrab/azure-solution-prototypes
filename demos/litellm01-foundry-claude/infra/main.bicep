@description('Azure region for resources')
param location string = 'eastus2'

@description('Demo ID used for unique naming')
param demoId string = 'litellm01'

@description('Optional suffix to avoid naming collisions')
param uniqueSuffix string = uniqueString(subscription().id, resourceGroup().id)

@description('Foundry model deployment name. Validate availability and version in the target region before deployment.')
param deploymentName string = 'gpt-5.4'

@description('Foundry model name. Usually matches deploymentName for this demo.')
param modelName string = 'gpt-5.4'

@description('Foundry model version. Validate this value against the current regional catalog.')
param modelVersion string = '2026-03-05'

@description('Model capacity in thousands of tokens per minute.')
param deploymentCapacityK int = 100

@description('Container image reference. The first pass leaves the public app disabled until the image is built and secrets are available.')
param containerImageReference string = ''

@description('Azure AI Services account key. Supplied only by the deployment notebook after the account is created.')
@secure()
param azureApiKey string = ''

@description('LiteLLM proxy master key. Generated by the deployment notebook and never committed.')
@secure()
param proxyMasterKey string = ''

var normalizedDemoId = toLower(replace(demoId, '-', ''))
var accountName = take('ai${normalizedDemoId}${take(uniqueSuffix, 5)}', 24)
var projectName = 'proj-${toLower(demoId)}'
var acrName = take('acr${normalizedDemoId}${take(uniqueSuffix, 10)}', 50)
var logWorkspaceName = take('log-${normalizedDemoId}-${take(uniqueSuffix, 5)}', 63)
var containerEnvironmentName = take('cae-${normalizedDemoId}-${take(uniqueSuffix, 5)}', 32)
var containerAppName = take('ca-${normalizedDemoId}-${take(uniqueSuffix, 5)}', 32)
var proxyEnabled = !empty(containerImageReference) && !empty(azureApiKey) && !empty(proxyMasterKey)

var commonTags = {
  SecurityControl: 'Ignore'
}

var acrPullRoleDefinitionId = subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '7f951dda-4ed3-4680-a7ca-43fe172d538d')

resource aiServices 'Microsoft.CognitiveServices/accounts@2025-06-01' = {
  name: accountName
  location: location
  tags: commonTags
  kind: 'AIServices'
  identity: {
    type: 'SystemAssigned'
  }
  sku: {
    name: 'S0'
  }
  properties: {
    allowProjectManagement: true
    customSubDomainName: accountName
    // LiteLLM uses the Azure API key supplied as a Container App secret.
    disableLocalAuth: false
    dynamicThrottlingEnabled: false
    publicNetworkAccess: 'Enabled'
    restrictOutboundNetworkAccess: false
  }
}

resource foundryProject 'Microsoft.CognitiveServices/accounts/projects@2025-06-01' = {
  name: projectName
  location: location
  tags: commonTags
  parent: aiServices
  identity: {
    type: 'SystemAssigned'
  }
  properties: {
    description: 'Foundry project hosting the GPT-5.4 deployment used by LiteLLM.'
    displayName: 'LiteLLM Claude Code Prototype Project'
  }
}

resource aiDeployment 'Microsoft.CognitiveServices/accounts/deployments@2024-10-01' = {
  name: deploymentName
  parent: aiServices
  tags: commonTags
  sku: {
    name: 'GlobalStandard'
    capacity: deploymentCapacityK
  }
  properties: {
    model: {
      format: 'OpenAI'
      name: modelName
      version: modelVersion
    }
  }
}

resource acr 'Microsoft.ContainerRegistry/registries@2023-11-01-preview' = {
  name: acrName
  location: location
  tags: commonTags
  sku: {
    name: 'Basic'
  }
  properties: {
    adminUserEnabled: false
    publicNetworkAccess: 'Enabled'
  }
}

resource logWorkspace 'Microsoft.OperationalInsights/workspaces@2023-09-01' = {
  name: logWorkspaceName
  location: location
  tags: commonTags
  properties: {
    retentionInDays: 30
    sku: {
      name: 'PerGB2018'
    }
  }
}

resource containerEnvironment 'Microsoft.App/managedEnvironments@2024-03-01' = {
  name: containerEnvironmentName
  location: location
  tags: commonTags
  properties: {
    appLogsConfiguration: {
      destination: 'log-analytics'
      logAnalyticsConfiguration: {
        customerId: logWorkspace.properties.customerId
        sharedKey: logWorkspace.listKeys().primarySharedKey
      }
    }
  }
}

resource containerApp 'Microsoft.App/containerApps@2024-03-01' = if (proxyEnabled) {
  name: containerAppName
  location: location
  tags: commonTags
  identity: {
    type: 'SystemAssigned'
  }
  properties: {
    managedEnvironmentId: containerEnvironment.id
    configuration: {
      activeRevisionsMode: 'Single'
      ingress: {
        external: true
        targetPort: 4000
        transport: 'auto'
        allowInsecure: false
      }
      registries: [
        {
          server: acr.properties.loginServer
          identity: 'system'
        }
      ]
      secrets: [
        {
          name: 'azure-api-key'
          value: azureApiKey
        }
        {
          name: 'litellm-master-key'
          value: proxyMasterKey
        }
      ]
    }
    template: {
      containers: [
        {
          name: 'litellm'
          image: containerImageReference
          env: [
            {
              name: 'AZURE_API_BASE'
              value: aiServices.properties.endpoint
            }
            {
              name: 'AZURE_API_KEY'
              secretRef: 'azure-api-key'
            }
            {
              name: 'AZURE_API_VERSION'
              value: '2025-01-01-preview'
            }
            {
              name: 'AZURE_MODEL_DEPLOYMENT'
              value: deploymentName
            }
            {
              name: 'LITELLM_MASTER_KEY'
              secretRef: 'litellm-master-key'
            }
          ]
          resources: {
            cpu: 1
            memory: '2Gi'
          }
          probes: [
            {
              type: 'Liveness'
              httpGet: {
                path: '/health/liveliness'
                port: 4000
              }
              initialDelaySeconds: 20
              periodSeconds: 30
            }
          ]
        }
      ]
      scale: {
        minReplicas: 1
        maxReplicas: 2
      }
    }
  }
}

resource acrPullRoleAssignment 'Microsoft.Authorization/roleAssignments@2022-04-01' = if (proxyEnabled) {
  name: guid(acr.id, containerApp.name, 'AcrPull')
  scope: acr
  properties: {
    principalId: containerApp.identity.principalId
    roleDefinitionId: acrPullRoleDefinitionId
    principalType: 'ServicePrincipal'
  }
}

output location string = location
output resourceGroupName string = resourceGroup().name
output aiServicesAccountName string = aiServices.name
output aiServicesEndpoint string = aiServices.properties.endpoint
output foundryProjectName string = foundryProject.name
output deploymentName string = aiDeployment.name
output acrName string = acr.name
output acrLoginServer string = acr.properties.loginServer
output containerEnvironmentName string = containerEnvironment.name
output containerAppName string = proxyEnabled ? containerApp.name : ''
output proxyUrl string = proxyEnabled ? 'https://${containerApp.properties.configuration.ingress.fqdn}' : ''