# Reference only. Deployment generates ignored env/.env; do not copy this file.
# No keys or tokens belong here. The Azure CLI login supplies the caller identity.
AZURE_SUBSCRIPTION_ID=<generated-subscription-id>
AZURE_RESOURCE_GROUP=<generated-resource-group>
AZURE_LOCATION=<generated-region>
AZURE_AI_ENDPOINT=<generated-ai-endpoint>
AZURE_AI_ACCOUNT_NAME=<generated-account-name>
AZURE_AI_PROJECT_ENDPOINT=<generated-project-endpoint>
AZURE_API_BASE=<generated-azure-openai-root-endpoint>
AZURE_API_VERSION=<explicit-provider-api-version>
ASSERT_AZURE_USE_AAD=1
AZURE_TOKEN_CREDENTIALS=AzureCliCredential
ASSERT_TARGET_OLDER_MODEL=<generated-older-deployment-name>
# Omitted in generated .env while explicitly skipped; metadata records the reason.
ASSERT_TARGET_INTERMEDIATE_MODEL=<generated-intermediate-deployment-name>
ASSERT_TARGET_NEWER_MODEL=<generated-newer-deployment-name>
